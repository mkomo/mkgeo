#!/usr/bin/env python3
"""Generate a lightweight viewer-data JSON file for an mkgeo-render prefix.

The prefix must have matching .svg and .ndjson outputs. The output contains the
SVG filename and only properties.fill_trace metadata. An optional geoMercator
transform sidecar lets the reusable viewer align the SVG to a geographic map.
"""

import argparse
import json
from pathlib import Path


def artifact_path(prefix, extension):
    """Append a known artifact extension without changing a dotted prefix."""
    return Path(f"{prefix}{extension}")


def load_transform(path):
    """Load a projection sidecar and reject incomplete transform metadata."""
    try:
        transform = json.loads(path.read_text(encoding="utf-8"))
        forward = transform["forward"]
        for axis in ("x", "y"):
            float(forward[axis]["scale"])
            float(forward[axis]["translate"])
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        raise ValueError(f"invalid transform file {path}: {error}") from error
    return transform


def output_root(path):
    """Return the lexical ./output ancestor, without resolving its symlink."""
    for candidate in (path.parent, *path.parents):
        if candidate.name == "output":
            return candidate
    return None


def update_map_manifest(root):
    """Index generated viewer-data files for the reusable viewer's selector."""
    maps = []
    for data_path in sorted(root.rglob("*.viewer.json")):
        relative_path = data_path.relative_to(root).as_posix()
        maps.append({"id": relative_path.removesuffix(".viewer.json"), "label": relative_path.removesuffix(".viewer.json")})
    manifest_path = root / "viewer-maps.json"
    manifest_path.write_text(json.dumps({"version": 1, "maps": maps}, separators=(",", ":")) + "\n", encoding="utf-8")
    return manifest_path, len(maps)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prefix", type=Path, help="mkgeo-render output prefix, without .svg or .ndjson")
    parser.add_argument("--output", type=Path, help="Viewer-data JSON output path (defaults to <prefix>.viewer.json)")
    parser.add_argument("--transform", type=Path, help="geoMercator .transform.json sidecar for a Leaflet base layer")
    args = parser.parse_args()

    ndjson_path = artifact_path(args.prefix, ".ndjson")
    svg_path = artifact_path(args.prefix, ".svg")
    output_path = args.output or artifact_path(args.prefix, ".viewer.json")
    for path in (ndjson_path, svg_path):
        if not path.is_file():
            parser.error(f"file not found: {path}")

    records = {}
    with ndjson_path.open(encoding="utf-8") as source:
        for line_number, line in enumerate(source, start=1):
            try:
                feature = json.loads(line)
            except json.JSONDecodeError as error:
                parser.error(f"invalid NDJSON at {ndjson_path}:{line_number}: {error.msg}")
            feature_id = str(feature.get("id", ""))
            properties = feature.get("properties") or {}
            fill_trace = properties.get("fill_trace")
            if feature_id and fill_trace is not None:
                records[feature_id] = fill_trace
    if not records:
        parser.error(f"no features with properties.fill_trace found in {ndjson_path}")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    viewer_data = {
        "version": 1,
        "title": f"mkgeo viewer: {args.prefix.name}",
        "svg": svg_path.name,
        "records": records,
    }
    if args.transform:
        try:
            viewer_data["transform"] = load_transform(args.transform)
        except ValueError as error:
            parser.error(str(error))
    output_path.write_text(json.dumps(viewer_data, separators=(",", ":")) + "\n", encoding="utf-8")
    print(f"Wrote {output_path} with {len(records):,} property hover records")
    root = output_root(output_path)
    if root:
        manifest_path, map_count = update_map_manifest(root)
        print(f"Updated {manifest_path} with {map_count:,} available maps")
if __name__ == "__main__":
    main()
