#!/usr/bin/env python3
"""Generate a lightweight interactive HTML viewer for an mkgeo-render prefix.

The prefix must have matching .svg and .ndjson outputs.  The viewer references
the SVG directly and embeds only ID/address/value metadata, so the browser does
not need to load or parse the original (often large) NDJSON file.
"""

import argparse
import html
import json
import os
import sys
from pathlib import Path


HTML_TEMPLATE = """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<style>
  * {{ box-sizing: border-box; }}
  body {{ margin: 0; background: #f8fafc; color: #0f172a; font-family: system-ui, sans-serif; }}
  #map {{ display: block; width: 100vw; height: 100vh; border: 0; touch-action: none; }}
  #tip {{ position: fixed; z-index: 2; display: none; max-width: 22rem; padding: .45rem .65rem;
          border-radius: .3rem; background: rgba(15,23,42,.95); color: white; font-size: 14px;
          line-height: 1.35; pointer-events: none; box-shadow: 0 2px 10px rgba(0,0,0,.25); }}
  #tip .value {{ color: #bae6fd; }}
</style>
<object id="map" data="{svg_url}" type="image/svg+xml" aria-label="Property choropleth map"></object>
<div id="tip" role="status"></div>
<script>
const records = new Map({records});
const map = document.getElementById('map');
const tip = document.getElementById('tip');

function placeTip(event) {{
  const margin = 14;
  const width = tip.offsetWidth, height = tip.offsetHeight;
  tip.style.left = Math.min(event.clientX + margin, innerWidth - width - margin) + 'px';
  tip.style.top = Math.min(event.clientY + margin, innerHeight - height - margin) + 'px';
}}
function clearTip() {{ tip.style.display = 'none'; }}

map.addEventListener('load', () => {{
  const svg = map.contentDocument;
  if (!svg) return;
  const root = svg.documentElement;
  const initialBox = root.viewBox.baseVal;
  const original = {{ x: initialBox.x, y: initialBox.y, width: initialBox.width, height: initialBox.height }};
  let current = {{ ...original }};
  let target = {{ ...original }};
  let animationFrame;

  function applyViewBox(box) {{
    root.setAttribute('viewBox', [box.x, box.y, box.width, box.height].join(' '));
  }}
  function animateZoom() {{
    const easing = .28;
    current = {{
      x: current.x + (target.x - current.x) * easing,
      y: current.y + (target.y - current.y) * easing,
      width: current.width + (target.width - current.width) * easing,
      height: current.height + (target.height - current.height) * easing,
    }};
    applyViewBox(current);
    const remaining = Math.abs(target.x - current.x) + Math.abs(target.y - current.y) +
      Math.abs(target.width - current.width) + Math.abs(target.height - current.height);
    if (remaining > .01) animationFrame = requestAnimationFrame(animateZoom);
    else {{ current = {{ ...target }}; applyViewBox(current); animationFrame = undefined; }}
  }}
  function scheduleZoom() {{ if (!animationFrame) animationFrame = requestAnimationFrame(animateZoom); }}
  function pointInSvg(event) {{
    const point = root.createSVGPoint();
    point.x = event.clientX;
    point.y = event.clientY;
    return point.matrixTransform(root.getScreenCTM().inverse());
  }}
  svg.addEventListener('wheel', (event) => {{
    event.preventDefault();
    const point = pointInSvg(event);
    const factor = Math.exp(event.deltaY * .0015);
    const minimumWidth = original.width / 64;
    const maximumWidth = original.width;
    const width = Math.max(minimumWidth, Math.min(maximumWidth, target.width * factor));
    const scale = width / target.width;
    target = {{
      x: point.x - (point.x - target.x) * scale,
      y: point.y - (point.y - target.y) * scale,
      width,
      height: target.height * scale,
    }};
    scheduleZoom();
  }}, {{ passive: false }});
  svg.addEventListener('dblclick', (event) => {{
    event.preventDefault();
    target = {{ ...original }};
    scheduleZoom();
  }});
  // One delegated listener handles every property path, avoiding per-path
  // closures and listeners on maps with tens of thousands of parcels.
  svg.addEventListener('pointermove', (event) => {{
    const path = event.target.closest && event.target.closest('path[id]');
    const record = path && records.get(path.id);
    if (!record) {{ clearTip(); return; }}
    tip.innerHTML = '<strong>' + escapeHtml(record.address || path.id) + '</strong><br>' +
      '<span class="value">' + escapeHtml(record.value) + '</span>';
    tip.style.display = 'block';
    placeTip(event);
  }});
  svg.addEventListener('pointerleave', clearTip);
}});
function escapeHtml(value) {{
  const node = document.createElement('span');
  node.textContent = value;
  return node.innerHTML;
}}
</script>
</html>
"""


def fill_trace_text(fill_trace):
    """Format the mapper-agnostic trace stored beside a feature's fill."""
    if fill_trace is None:
        return "Value unavailable (re-render after adding properties.fill_trace)"
    if isinstance(fill_trace, dict):
        value = fill_trace.get("value_used")
        explanation = fill_trace.get("value_explanation")
        if value is None:
            return json.dumps(fill_trace, sort_keys=True)
        text = value_text(value)
        return f"{text} — {explanation}" if explanation else text
    return value_text(fill_trace)


def value_text(value):
    if isinstance(value, (int, float)):
        return format(value, ",.2f")
    return str(value)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prefix", type=Path, help="mkgeo-render output prefix, without .svg or .ndjson")
    parser.add_argument("--output", type=Path, help="HTML output path (defaults to <prefix>.html)")
    args = parser.parse_args()

    ndjson_path = args.prefix.with_suffix(".ndjson")
    svg_path = args.prefix.with_suffix(".svg")
    output_path = args.output or args.prefix.with_suffix(".html")
    for path in (ndjson_path, svg_path):
        if not path.is_file():
            parser.error(f"file not found: {path}")

    records = {}
    with ndjson_path.open(encoding="utf-8") as source:
        for line_number, line in enumerate(source, start=1):
            try:
                feature = json.loads(line)
            except json.JSONDecodeError as error:
                parser.error(f"invalid NDJSON at {ndjson_path}:{line_number}: {error.msg}")
            feature_id = str(feature.get("id", ""))
            properties = feature.get("properties") or {}
            oars = properties.get("oars_props") or {}
            if feature_id:
                records[feature_id] = {
                    "address": oars.get("address") or properties.get("address") or properties.get("desc1") or feature_id,
                    "value": fill_trace_text(properties.get("fill_trace")),
                }
    if not records:
        parser.error(f"no feature IDs found in {ndjson_path}")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    svg_url = Path(os.path.relpath(svg_path, output_path.parent)).as_posix()
    page = HTML_TEMPLATE.format(
        title=html.escape(f"mkgeo viewer: {args.prefix.name}"),
        svg_url=html.escape(svg_url, quote=True),
        records=json.dumps(list(records.items()), separators=(",", ":")),
    )
    output_path.write_text(page, encoding="utf-8")
    value_count = sum(not record["value"].startswith("Value unavailable") for record in records.values())
    print(f"Wrote {output_path} with {len(records):,} property hover records ({value_count:,} with fill traces)")
    if value_count == 0:
        print("note: this NDJSON has no properties.fill_trace metadata; rerun mkgeo-render to include values", file=sys.stderr)


if __name__ == "__main__":
    main()
