#!/usr/bin/env python3
"""Generate a lightweight viewer-data JSON file for an mkgeo-render prefix.

The prefix must have matching .svg and .ndjson outputs. The output contains the
SVG filename and only ID/address/value metadata, so the reusable HTML viewer
does not need to load or parse the original (often large) NDJSON file.
"""

import argparse
import json
import sys
from pathlib import Path


def fill_trace_text(fill_trace):
    """Format the mapper-agnostic trace stored beside a feature's fill."""
    if fill_trace is None:
        return "Value unavailable (re-render after adding properties.fill_trace)"
    if isinstance(fill_trace, dict):
        value = fill_trace.get("value_used")
        explanation = fill_trace.get("value_explanation")
        if value is None:
            return json.dumps(fill_trace, sort_keys=True)
        text = value_text(value)
        return f"{text} ({explanation})" if explanation else text
    return value_text(fill_trace)


def value_text(value):
    if isinstance(value, (int, float)):
        return format(value, ",.2f")
    return str(value)


def artifact_path(prefix, extension):
    """Append a known artifact extension without changing a dotted prefix."""
    return Path(f"{prefix}{extension}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prefix", type=Path, help="mkgeo-render output prefix, without .svg or .ndjson")
    parser.add_argument("--output", type=Path, help="Viewer-data JSON output path (defaults to <prefix>.viewer.json)")
    args = parser.parse_args()

    ndjson_path = artifact_path(args.prefix, ".ndjson")
    svg_path = artifact_path(args.prefix, ".svg")
    output_path = args.output or artifact_path(args.prefix, ".viewer.json")
    for path in (ndjson_path, svg_path):
        if not path.is_file():
            parser.error(f"file not found: {path}")

    records = {}
    with ndjson_path.open(encoding="utf-8") as source:
        for line_number, line in enumerate(source, start=1):
            try:
                feature = json.loads(line)
            except json.JSONDecodeError as error:
                parser.error(f"invalid NDJSON at {ndjson_path}:{line_number}: {error.msg}")
            feature_id = str(feature.get("id", ""))
            properties = feature.get("properties") or {}
            oars = properties.get("oars_props") or {}
            if feature_id:
                records[feature_id] = {
                    "address": oars.get("address") or properties.get("address") or properties.get("desc1") or feature_id,
                    "value": fill_trace_text(properties.get("fill_trace")),
                }
    if not records:
        parser.error(f"no feature IDs found in {ndjson_path}")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    viewer_data = {
        "version": 1,
        "title": f"mkgeo viewer: {args.prefix.name}",
        "svg": svg_path.name,
        "records": records,
    }
    output_path.write_text(json.dumps(viewer_data, separators=(",", ":")) + "\n", encoding="utf-8")
    value_count = sum(not record["value"].startswith("Value unavailable") for record in records.values())
    print(f"Wrote {output_path} with {len(records):,} property hover records ({value_count:,} with fill traces)")
    if value_count == 0:
        print("note: this NDJSON has no properties.fill_trace metadata; rerun mkgeo-render to include values", file=sys.stderr)


if __name__ == "__main__":
    main()
